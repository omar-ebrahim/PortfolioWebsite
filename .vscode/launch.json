{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node-terminal",
            "name": "Start dev server",
            "request": "launch",
            "command": "npm run dev",
            "cwd": "${workspaceFolder}/Portfolio.Web"
        },
        {
            "type": "chrome",
            "name": "Launch dev in Chrome",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/Portfolio.Web",
            "sourceMaps": true
        },
        {
            "type": "node-terminal",
            "name": "Launch dev in default browser",
            "request": "launch",
            "command": "npm run dev -- --open",
            "cwd": "${workspaceFolder}/Portfolio.Web"
        },
        {
            "type": "node-terminal",
            "name": "Run Script: build",
            "request": "launch",
            "command": "npm run build",
            "cwd": "${workspaceFolder}/Portfolio.Web"
        },
        {
            "type": "node-terminal",
            "name": "Run Script: lint",
            "request": "launch",
            "command": "npm run lint",
            "cwd": "${workspaceFolder}/Portfolio.Web"
        },
        {
            "type": "node-terminal",
            "name": "Run Script: preview",
            "request": "launch",
            "command": "npm run preview",
            "cwd": "${workspaceFolder}/Portfolio.Web"
        },
        {
            "type": "node-terminal",
            "name": "Run Script: format",
            "request": "launch",
            "command": "npm run format",
            "cwd": "${workspaceFolder}/Portfolio.Web"
        },
        {
            "type": "node-terminal",
            "name": "Run Script: storybook",
            "request": "launch",
            "command": "npm run storybook",
            "cwd": "${workspaceFolder}/Portfolio.Web"
        },
        {
            "type": "node-terminal",
            "name": "Run Script: build storybook",
            "request": "launch",
            "command": "npm run build-storybook",
            "cwd": "${workspaceFolder}/Portfolio.Web"
        }
    ],
    "compounds": [
        {
            "name": "Launch dev",
            "configurations": [
                "Start dev server",
                "Launch dev in Chrome"
            ],
            "stopAll": true
        },
    ]
}